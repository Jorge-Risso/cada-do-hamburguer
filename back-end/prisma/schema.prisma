

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  password String
  cep String
  type String
}

model Product{
  id Int @id @default(autoincrement())
  name String
  description String
  price Float
  category String 
  img String
  createdAt DateTime @default(now())
}


